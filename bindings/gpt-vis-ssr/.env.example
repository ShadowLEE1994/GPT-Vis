# HTTP server
PORT=7001
MAX_BODY_SIZE=1048576

# OSS base config (required)
OSS_ENDPOINT=obs-cn-east-1.ctyun.cn
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=your-ak
OSS_ACCESS_KEY_SECRET=your-sk

# Optional OSS config
OSS_REGION=
OSS_PORT=
OSS_SECURE=true
OSS_PATH_STYLE=true
OSS_CNAME=false
OSS_OBJECT_PREFIX=gpt-vis

# If set, returned image URL will use this CDN/domain instead of OSS default url
OSS_CDN_BASE_URL=

# Security switch:
# false: ignore request body `ossConfig`, only use env variables
# true: allow request body `ossConfig` to override env values
ALLOW_REQUEST_OSS_CONFIG=false
